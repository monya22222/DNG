/* Dreams & Goals v32.1 P0 — read-only Forecast Engine.
 * Pure computations in integer EUR cents. Never reads/writes app storage.
 * Yearly rates are effective annual rates; deposits occur at month-end.
 */
(function(root,factory){
  'use strict';
  const api=factory();
  if(typeof module==='object'&&module.exports)module.exports=api;
  if(root)root.DNGForecast=api;
})(typeof globalThis!=='undefined'?globalThis:this,function(){
  'use strict';
  const MAX_CENTS=9_000_000_000_000;
  function wholeCents(value,name){
    if(!Number.isSafeInteger(value)||value<0||value>MAX_CENTS)throw new RangeError(name+' must be a nonnegative safe integer (EUR cents)');
    return value;
  }
  function validRate(value,name){
    if(!Number.isFinite(value)||value<=-100||value>1000)throw new RangeError(name+' must be greater than -100% and no more than 1000%');
    return value;
  }
  function roundCents(value){
    if(!Number.isFinite(value)||value<0||value>MAX_CENTS)throw new RangeError('Forecast amount out of supported range');
    return Math.round(value);
  }
  function validateCore(p){
    if(!p||typeof p!=='object')throw new TypeError('Forecast parameters are required');
    if(!Number.isInteger(p.months)||p.months<1||p.months>600)throw new RangeError('Planning horizon must be 1–600 months');
    wholeCents(p.initialCapitalCents??0,'initialCapitalCents');
    validRate(p.annualReturnPct??0,'annualReturnPct');
    validRate(p.annualContributionIncreasePct??0,'annualContributionIncreasePct');
    wholeCents(p.initialMonthlyCents??0,'initialMonthlyCents');
  }
  function simulate(p){
    validateCore(p);
    const r=Math.pow(1+(p.annualReturnPct??0)/100,1/12)-1;
    const growth=1+(p.annualContributionIncreasePct??0)/100;
    const initialCapital=p.initialCapitalCents??0;
    let current=initialCapital,contributions=0;
    const contributionsByYear=[];
    for(let m=0;m<p.months;m++){
      const monthPayment=roundCents((p.initialMonthlyCents??0)*Math.pow(growth,Math.floor(m/12)));
      // End-of-month contribution; previously held capital earns return for this month.
      current=roundCents(current*(1+r))+monthPayment;
      if(!Number.isSafeInteger(current)||current>MAX_CENTS)throw new RangeError('Forecast balance out of supported range');
      contributions+=monthPayment;
      if(!Number.isSafeInteger(contributions))throw new RangeError('Forecast contributions out of supported range');
      const year=Math.floor(m/12);
      contributionsByYear[year]=(contributionsByYear[year]||0)+monthPayment;
    }
    return {valueCents:current,contributedCents:contributions,initialCapitalCents:initialCapital,
      estimatedReturnCents:current-initialCapital-contributions,contributionsByYear};
  }
  function targetAtHorizon(p){
    wholeCents(p.targetCents,'targetCents');
    if(!Number.isInteger(p.months)||p.months<1||p.months>600)throw new RangeError('Planning horizon must be 1–600 months');
    validRate(p.annualTargetGrowthPct??0,'annualTargetGrowthPct');
    return roundCents(p.targetCents*Math.pow(1+(p.annualTargetGrowthPct??0)/100,p.months/12));
  }
  function requiredInitialContribution(p){
    validateCore({...p,initialMonthlyCents:0});
    const targetCents=wholeCents(p.targetAtHorizonCents,'targetAtHorizonCents');
    const test=initialMonthlyCents=>simulate({...p,initialMonthlyCents}).valueCents;
    if(test(0)>=targetCents)return 0;
    let upper=1;
    while(true){
      let value;
      try{value=test(upper)}catch(err){if(!(err instanceof RangeError))throw err;throw new RangeError('Required monthly contribution exceeds supported range');}
      if(value>=targetCents)break;
      if(upper>=MAX_CENTS/2)throw new RangeError('Required monthly contribution exceeds supported range');
      upper*=2;
    }
    let lower=0;
    while(lower+1<upper){
      const mid=lower+Math.floor((upper-lower)/2);
      if(test(mid)>=targetCents)upper=mid;else lower=mid;
    }
    return upper;
  }
  function scenario(p){
    validateCore(p);
    wholeCents(p.targetCents,'targetCents');
    validRate(p.inflationPct??0,'inflationPct');
    const target=targetAtHorizon(p);
    const actual=simulate(p);
    const required=requiredInitialContribution({...p,targetAtHorizonCents:target});
    const inflationFactor=Math.pow(1+(p.inflationPct??0)/100,p.months/12);
    return {...actual,requiredInitialMonthlyCents:required,targetAtHorizonCents:target,
      gapCents:actual.valueCents-target,
      realValueCents:roundCents(actual.valueCents/inflationFactor),
      realTargetCents:roundCents(target/inflationFactor),
      assumptions:{months:p.months,annualReturnPct:p.annualReturnPct??0,annualContributionIncreasePct:p.annualContributionIncreasePct??0,
        inflationPct:p.inflationPct??0,annualTargetGrowthPct:p.annualTargetGrowthPct??0}};
  }
  return Object.freeze({simulate,requiredInitialContribution,targetAtHorizon,scenario});
});

