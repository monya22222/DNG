  const passed=asOf<from?0:asOf>until?totalDays:Math.max(0,daysBetween(from,asOf)+1);
  return Math.max(0,Math.min(1,passed/totalDays));
 });
 const chunk=n<=24?1:n<=60?3:12,cellCount=Math.ceil(n/chunk);
 const html=[];
 for(let i=0;i<cellCount;i++){
  const vals=slotProgress.slice(i*chunk,(i+1)*chunk),fraction=vals.reduce((a,b)=>a+b,0)/vals.length;
  const pct=Math.round(fraction*1000)/10,light=74-32*(cellCount===1?0:i/(cellCount-1));
  const first=i*chunk+1,last=Math.min(n,(i+1)*chunk),what=first===last?`${first}. months`:`${first}–${last}. months`;
  html.push(`<span class="time-segment" title="${what}: ${pct.toLocaleString('en-GB')}% elapsed"><i style="width:${pct}%;--segment-color:hsl(32 91% ${light.toFixed(1)}%)"></i></span>`);
