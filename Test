/* Header overview: a monthly task is a Goal with a saved funding requirement or a
   currently payable repayment. Savings keep their locked monthly target; loans keep
   the contractual month-start due even after payments have been recorded. */
function headerMonthlyFunding(ref=today()){
 const month=monthId(ref),first=+monthStart(ref),end=+new Date(ref.getFullYear(),ref.getMonth()+1,1);
 const netByGoal=new Map();
 for(const l of st.log){
  if(!l||!Number.isFinite(l.t)||l.t<first||l.t>=end||!l.gid)continue;
  if(l.type!=='al'&&l.type!=='rel')continue;
  netByGoal.set(l.gid,(netByGoal.get(l.gid)||0)+(l.type==='al'?l.amt:-l.amt));
 }
 const items=[];
 for(const g of st.goals){
  if(g.status==='trash'||g.hibernated||g.type!=='goal')continue;
  const isLoan=financeMode(g)==='finance'&&g.repayment&&validRepayment(g.repayment);
  if(isLoan){
   const r=g.repayment;
   let paidBefore=0,paidInMonth=0;
   for(const payment of r.payments){
    if(payment.t<first)paidBefore+=payment.amount;
    else if(payment.t<end)paidInMonth+=payment.amount;
   }
   // Contractual amount already due as of this month, including older unpaid parts.
   // Payments made DURING this month do not shrink the original monthly target.
   const dueThrough=repaymentSchedule(r).reduce((a,p)=>a+(p.month<=month?p.amount:0),0);
   const expected=Math.max(0,dueThrough-paidBefore);
   if(expected>0||paidInMonth>0)items.push({id:g.id,title:g.title,kind:'loan',expected,actual:paidInMonth});
   continue;
  }
  if(g.status!=='active'&&g.status!=='done')continue;
  const snap=st.monthFunding?.[g.id+'|'+month];
  const actual=Math.max(0,netByGoal.get(g.id)||0);
  const advanced=!!p2RevisionAt(g,month),due=advanced?getConfirmedMonthDue(g,month,ref):null;
  const fallback=g.status==='active'&&isPlannedActive(g)?financePlan(g,ref).current+actual:0;
  const frozen=st.monthObligations?.[p2Key(g.id,month)];
  const expected=advanced?(frozen?frozen.expectedCents+frozen.carriedInCents:(due.expectedCents+due.carryForwardCents+actual)):(Number.isSafeInteger(snap?.expected)&&snap.expected>0?snap.expected:Math.max(0,fallback));
  if(expected>0)items.push({id:g.id,title:g.title,kind:'saving',expected,actual});
 }
 items.sort((a,b)=>a.kind.localeCompare(b.kind)||a.title.localeCompare(b.title,'en'));
 return{month,items,expected:items.reduce((a,x)=>a+x.expected,0),actual:items.reduce((a,x)=>a+x.actual,0),done:items.filter(x=>x.expected>0&&x.actual>=x.expected).length};
}
