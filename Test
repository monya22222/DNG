/* P4 controlled ledger candidate — schema 7. Never promote data solely on a shadow parity check.
 * All P4 records are appended with existing P3 events in the same atomicAction snapshot.
 * Compatibility fields remain authoritative until real-fixture, restart, rollback and ZIP gates pass.
 */
const P4_ACCOUNTS=Object.freeze({free:'cash:free',reserve:'cash:reserved:',cost:'asset:cost:',principal:'liability:principal:'});
const P4_CORE_PREFIX=['cash:free','cash:reserved:','asset:cost:','liability:principal:'];
const p4IsCore=k=>k==='cash:free'||P4_CORE_PREFIX.slice(1).some(s=>k.startsWith(s));
function p4BookAccounts(data){
 const out={'cash:free':data.free||0};
 for(const g of data.goals||[])if(g.alloc)out['cash:reserved:'+g.id]=g.alloc;
 for(const a of data.assets||[])if(a.status==='owned'&&a.remainingCostBasisCents&&a.costBasisKnown)out['asset:cost:'+a.id]=a.remainingCostBasisCents;
 for(const l of data.liabilities||[])if(l.status==='active'&&l.principalMethod!=='unknown'&&l.lastKnownPrincipalCents!=null&&l.lastKnownPrincipalCents)out['liability:principal:'+l.id]=-l.lastKnownPrincipalCents;
